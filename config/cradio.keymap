#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // เลเยอร์เริ่มต้น (Layer 0)
        default_layer {
            // display-name = "SuperMini"; // (ไม่บังคับ)
            bindings = <
                &kp LG(C)  // ตำแหน่ง 0,0: ปุ่ม 1 (P0.02) -> Command + C (Copy)
                &kp LG(V)  // ตำแหน่ง 1,0: ปุ่ม 2 (P0.29) -> Command + V (Paste)
            >;
        };
        
        // หากต้องการให้ Layer อื่นๆ เป็น &trans ทั้งหมด (ส่งผ่าน) สามารถทำได้
        // แต่สำหรับ 2 ปุ่มนี้ อาจไม่จำเป็นต้องมี Layer อื่นๆ
    };
};